# ==============================================================================
# JobRadar v1.0.1 - Variáveis de Ambiente de Exemplo
# NUNCA insira tokens, senhas ou URLs reais de webhook neste arquivo.
# Copie este arquivo para .env e preencha com suas configurações de ambiente.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# String de conexão PostgreSQL padrão (ou Connection Pooling do Supabase na porta 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Conexão direta para migrations no Supabase (porta 5432) - opcional se DATABASE_URL já for direta
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Discord Webhooks
# Crie os webhooks nos canais correspondentes do seu servidor Discord.
# O sistema funciona mesmo se apenas o DISCORD_WEBHOOK_DEFAULT estiver definido.
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_DEFAULT=https://discord.com/api/webhooks/123456789012345678/example-token-here
DISCORD_WEBHOOK_INTERN=
DISCORD_WEBHOOK_JUNIOR=
DISCORD_WEBHOOK_MID=
DISCORD_WEBHOOK_SENIOR=
DISCORD_WEBHOOK_BRAZIL_REMOTE=
DISCORD_WEBHOOK_INTERNATIONAL=
DISCORD_WEBHOOK_USD=

# ------------------------------------------------------------------------------
# Comportamento Operacional
# ------------------------------------------------------------------------------
# Modo de simulação: quando true, processa tudo mas NÃO envia requisições reais ao Discord
DRY_RUN=false

# Trava de segurança para publicação: deve ser explicitamente true para habilitar disparos reais no Discord
PUBLICATION_ENABLED=false

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Limite máximo de publicações por canal por ciclo de execução (proteção contra flood)
MAX_PUBLICATIONS_PER_RUN=5

# Limite diário de publicações por canal
MAX_PUBLICATIONS_DAILY=50

# Timeout de rede em milissegundos para coletas e publicações
REQUEST_TIMEOUT_MS=10000

# Número máximo de retentativas automáticas com backoff para requisições com falha transitória
MAX_RETRIES=3

# Bootstrap histórico: quando true na primeira execução, marca vagas existentes como históricas sem disparar no Discord
BOOTSTRAP_MARK_AS_HISTORICAL=true
